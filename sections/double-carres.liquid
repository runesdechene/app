      "min": 600,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "default": 1400,
      "info": "Utilisé uniquement en mode Largeur de page, comme fallback si --page-width n'est pas défini par le thème."
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "label": "Marge supérieure",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "label": "Marge inférieure",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_top",
