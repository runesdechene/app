                <div class="rdc-bento-card-img-wrap-{{ section.id }}">
                  {%- if block.settings.image_mobile != blank -%}
                    <img src="{{ block.settings.image_mobile | image_url: width: 800 }}" alt="{{ block.settings.image_mobile.alt | default: display_title_m | escape }}" class="rdc-bento-img{% if is_brand_card_m %} rdc-bento-brand-bg-image-{{ section.id }}{% endif %}" loading="lazy" width="{{ block.settings.image_mobile.width }}" height="{{ block.settings.image_mobile.height }}">
                  {%- elsif block.settings.image_desktop != blank -%}
                    <img src="{{ block.settings.image_desktop | image_url: width: 800 }}" alt="{{ block.settings.image_desktop.alt | default: display_title_m | escape }}" class="rdc-bento-img{% if is_brand_card_m %} rdc-bento-brand-bg-image-{{ section.id }}{% endif %}" loading="lazy">
                  {%- elsif block.settings.collection != blank and block.settings.collection.image != blank -%}
                    <img src="{{ block.settings.collection.image | image_url: width: 800 }}" alt="{{ block.settings.collection.title | escape }}" class="rdc-bento-img{% if is_brand_card_m %} rdc-bento-brand-bg-image-{{ section.id }}{% endif %}" loading="lazy">
                  {%- else -%}
                    {%- if is_brand_card_m -%}
                      {%- assign brand_placeholder_class_m = 'rdc-bento-img rdc-bento-brand-bg-image-' | append: section.id -%}
                      {{ 'collection-1' | placeholder_svg_tag: brand_placeholder_class_m }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'rdc-bento-img' }}
                    {%- endif -%}
                  {%- endif -%}

                  {%- if is_brand_card_m -%}
                    <span class="rdc-bento-brand-overlay-{{ section.id }}"></span>
                    <span class="rdc-bento-brand-gradient-left-{{ section.id }}"></span>
                    <span class="rdc-bento-brand-gradient-right-{{ section.id }}"></span>

                    {%- if block.settings.brand_left_motif != blank -%}
                      <img src="{{ block.settings.brand_left_motif | image_url: width: 1000 }}" alt="{{ block.settings.brand_left_motif.alt | escape }}" class="rdc-bento-brand-motif-{{ section.id }} rdc-bento-brand-motif-left-{{ section.id }}" loading="lazy" width="{{ block.settings.brand_left_motif.width }}" height="{{ block.settings.brand_left_motif.height }}">
                    {%- endif -%}

                    {%- if block.settings.brand_right_motif != blank -%}
                      <img src="{{ block.settings.brand_right_motif | image_url: width: 1000 }}" alt="{{ block.settings.brand_right_motif.alt | escape }}" class="rdc-bento-brand-motif-{{ section.id }} rdc-bento-brand-motif-right-{{ section.id }}" loading="lazy" width="{{ block.settings.brand_right_motif.width }}" height="{{ block.settings.brand_right_motif.height }}">
                    {%- endif -%}
                  {%- endif -%}
                </div>

                {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
                  <span class="rdc-bento-badge-{{ section.id }}{% if block.settings.badge_shine %} rdc-badge-shine{% endif %}" style="--rdc-badge-bg: {{ block.settings.badge_bg_color }}; --rdc-badge-color: {{ block.settings.badge_text_color }};">
                    {{ block.settings.badge_text }}
                  </span>
                {%- endif -%}

                {%- if is_brand_card_m -%}
                  <div class="rdc-bento-brand-content-{{ section.id }}">
                    {%- if block.settings.title_image != blank -%}
                      <img src="{{ block.settings.title_image | image_url: width: 1000 }}" alt="{{ block.settings.title_image.alt | default: display_title_m | escape }}" class="rdc-bento-brand-title-image-{{ section.id }}" loading="lazy" width="{{ block.settings.title_image.width }}" height="{{ block.settings.title_image.height }}">
                    {%- elsif display_title_m != blank -%}
                      <h3 class="rdc-bento-brand-title-text-{{ section.id }}">{{ display_title_m }}</h3>
                    {%- endif -%}
                  </div>
                {%- elsif show_title_area_m -%}
                  {%- capture title_style_m -%}
                    --rdc-title-image-align: {{ title_align_css_m }};
                    --rdc-title-text-align: {{ title_text_align_m }};
                    --rdc-title-image-max-width: {{ block.settings.title_image_max_width_desktop | default: 260 }}px;
                    --rdc-title-image-max-height: {{ block.settings.title_image_max_height_desktop | default: 120 }}px;
                    --rdc-title-image-mobile-max-width: {{ block.settings.title_image_max_width_mobile | default: 220 }}px;
                    --rdc-title-image-mobile-max-height: {{ block.settings.title_image_max_height_mobile | default: 100 }}px;
                  {%- endcapture -%}

                  {%- if section.settings.title_position == 'on_image' -%}
                    <div class="rdc-bento-title-overlay-{{ section.id }}" style="{{ title_style_m | strip }}">
                      <div class="rdc-bento-title-content-{{ section.id }}">
                        {%- if display_title_m != blank -%}<h3 class="rdc-bento-title">{{ display_title_m }}</h3>{%- endif -%}
                        {%- if block.settings.title_image != blank -%}
                          <img src="{{ block.settings.title_image | image_url: width: 800 }}" alt="{{ block.settings.title_image.alt | default: display_title_m | escape }}" class="rdc-bento-card-title-image-{{ section.id }}" loading="lazy" width="{{ block.settings.title_image.width }}" height="{{ block.settings.title_image.height }}">
                        {%- endif -%}
                      </div>
                    </div>
                  {%- elsif section.settings.title_position == 'below_image' -%}
                    <div class="rdc-bento-title-below-{{ section.id }}" style="{{ title_style_m | strip }}">
                      <div class="rdc-bento-title-content-{{ section.id }}">
                        {%- if display_title_m != blank -%}<h3 class="rdc-bento-title">{{ display_title_m }}</h3>{%- endif -%}
                        {%- if block.settings.title_image != blank -%}
                          <img src="{{ block.settings.title_image | image_url: width: 800 }}" alt="{{ block.settings.title_image.alt | default: display_title_m | escape }}" class="rdc-bento-card-title-image-{{ section.id }}" loading="lazy" width="{{ block.settings.title_image.width }}" height="{{ block.settings.title_image.height }}">
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </{{ card_tag_m }}>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="rdc-carousel-dots-{{ section.id }}" id="rdc-carousel-dots-{{ section.id }}"></div>
    </div>
  </div>
</section>

<script>
(function() {
  var sid = '{{ section.id }}';

  function initRdcCarousel() {
    var track = document.getElementById('rdc-carousel-track-' + sid);
    var dotsWrap = document.getElementById('rdc-carousel-dots-' + sid);

    if (!track || !dotsWrap) return;
    if (track.dataset.rdcCarouselInitialized === 'true') return;

    track.dataset.rdcCarouselInitialized = 'true';

    var slides = track.querySelectorAll('.rdc-carousel-slide-' + sid);
    var total = slides.length;

    dotsWrap.innerHTML = '';

    if (total < 1) {
      dotsWrap.style.display = 'none';
      return;
    }

    dotsWrap.style.display = 'flex';

    var current = 0;
    var autoDelay = {{ section.settings.autoplay_speed }};
    var autoTimer = null;
    var dots = [];
    var startX = 0;

    function goTo(idx) {
      current = Math.max(0, Math.min(idx, total - 1));
      track.style.transform = 'translateX(-' + (current * 100) + '%)';

      dots.forEach(function(dot, dotIndex) {
        dot.classList.toggle('active', dotIndex === current);
      });

      resetAuto();
    }

    for (var i = 0; i < total; i++) {
      var dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'rdc-carousel-dot-' + sid + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Slide ' + (i + 1));

      (function(idx) {
        dot.addEventListener('click', function() {
          goTo(idx);
        });
      })(i);

      dotsWrap.appendChild(dot);
      dots.push(dot);
    }

    if (total < 2) return;

    track.addEventListener('touchstart', function(event) {
      startX = event.touches[0].clientX;
    }, { passive: true });

    track.addEventListener('touchend', function(event) {
      var diff = startX - event.changedTouches[0].clientX;

      if (Math.abs(diff) > 40) {
        if (diff > 0 && current < total - 1) {
          goTo(current + 1);
        } else if (diff < 0 && current > 0) {
          goTo(current - 1);
        }
      }
    }, { passive: true });

    function startAuto() {
      if (autoDelay <= 0) return;

      autoTimer = setInterval(function() {
        goTo((current + 1) % total);
      }, autoDelay);
    }

    function resetAuto() {
      clearInterval(autoTimer);
      startAuto();
    }

    startAuto();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRdcCarousel);
  } else {
    initRdcCarousel();
  }

  document.addEventListener('shopify:section:load', initRdcCarousel);
})();
</script>

<script>
(function() {
  var countdowns = document.querySelectorAll('[data-rdc-countdown-section="{{ section.id }}"]');

  if (!countdowns.length) return;

  function pad(value) {
    return String(value).padStart(2, '0');
  }

  function updateCountdown(countdown) {
    var targetValue = countdown.getAttribute('data-countdown-target');
    var targetDate = new Date(targetValue);

    if (!targetValue || isNaN(targetDate.getTime())) return;

    var now = new Date();
    var distance = targetDate.getTime() - now.getTime();

    if (distance < 0) {
      distance = 0;
    }

    var days = Math.floor(distance / (1000 * 60 * 60 * 24));
    var hours = Math.floor((distance / (1000 * 60 * 60)) % 24);
    var minutes = Math.floor((distance / (1000 * 60)) % 60);
    var seconds = Math.floor((distance / 1000) % 60);

    var daysEl = countdown.querySelector('[data-days]');
    var hoursEl = countdown.querySelector('[data-hours]');
    var minutesEl = countdown.querySelector('[data-minutes]');
    var secondsEl = countdown.querySelector('[data-seconds]');

    if (daysEl) daysEl.textContent = pad(days);
    if (hoursEl) hoursEl.textContent = pad(hours);
    if (minutesEl) minutesEl.textContent = pad(minutes);
    if (secondsEl) secondsEl.textContent = pad(seconds);
  }

  function tick() {
    countdowns.forEach(updateCountdown);
  }

  tick();
  setInterval(tick, 1000);
})();
</script>

