---
interface Props {
  accessibility: string | null;
}

const { accessibility } = Astro.props;
---

{accessibility && (
  <div class="container" style="padding-bottom: 2rem;">
    <h2 style="font-family: var(--font-accent); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); margin-bottom: 1rem;">Infos pratiques</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 0.8rem;">
      <div style="background: var(--bg-warm); padding: 0.8rem 1.2rem; border-radius: 8px;">
        <span style="font-family: var(--font-accent); font-size: 0.68rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; display: block; margin-bottom: 0.2rem;">Accessibilité</span>
        <span style="font-weight: 600; font-size: 0.95rem;">{accessibility}</span>
      </div>
    </div>
  </div>
)}
