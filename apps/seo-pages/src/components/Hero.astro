---
interface Props {
  title: string;
  placeType: string;
  address: string;
  imageUrl: string | null;
}

const { title, placeType, address, imageUrl } = Astro.props;
---

<section style="position: relative; height: 75vh; min-height: 400px; overflow: hidden;">
  {imageUrl && (
    <img
      src={imageUrl}
      alt={title}
      loading="eager"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;"
    />
  )}
  <div style="position: absolute; inset: 0; background: linear-gradient(transparent 30%, rgba(0,0,0,0.7)); z-index: 1;"></div>
  <div style="position: absolute; bottom: 2.5rem; left: 2rem; right: 2rem; z-index: 2; max-width: var(--max-width); margin: 0 auto;">
    <p style="font-family: var(--font-accent); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; color: rgba(255,255,255,0.7); margin-bottom: 0.5rem;">
      {placeType}
    </p>
    <h1 style="font-size: 3.2rem; font-weight: 700; color: #fff; line-height: 1.05; margin-bottom: 0.5rem;">{title}</h1>
    {address && <p style="font-size: 0.95rem; color: rgba(255,255,255,0.5);">{address}</p>}
  </div>
</section>
