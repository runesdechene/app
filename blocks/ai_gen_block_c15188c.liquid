{% doc %}
  @prompt
    Je souhaiterais une section comprenant deux carrés, ces deux carrés doivent :
    Prendre le meme espacement sur PC.
    Avoir une image de fond
    Un titre
    Un bouton avec lien pour renvoi de page
    Un overlay
    
    La section doit être la plus personnalisable possible.
    Voici les éléments qui doivent se retrouver personnalisés :
    
    - Fond
    - Overlay
    - Texte
    - Elements du bouton
    - Taille/Largeur/GAP/Padding des carrés
    - Largeur/Hauteur de la section
    - Margin de la section.
    
    
    Important : les carrés sur format mobile doivent se retouvés EMPILES et prenant chacun La largeur totale de la section (modifiable également dynamiquement), Je souhaiterais uue la modification de l'overlay sois différente selon la carte (pas qu'elles aient le même overlay quoi)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-cards-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin-top: {{ block.settings.section_margin_top }}px;
    margin-bottom: {{ block.settings.section_margin_bottom }}px;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_background }};
  }

  .ai-dual-cards-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.cards_gap }}px;
    max-width: {{ block.settings.section_max_width }}px;
    margin: 0 auto;
  }

  .ai-dual-card-{{ ai_gen_id }} {
    position: relative;
    flex: 1;
    min-height: {{ block.settings.card_height }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-dual-card-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .ai-dual-card-overlay-1-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.card_1_overlay_color }};
    opacity: {{ block.settings.card_1_overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-dual-card-overlay-2-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.card_2_overlay_color }};
    opacity: {{ block.settings.card_2_overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-dual-card-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    text-align: {{ block.settings.text_alignment }};
    max-width: 100%;
  }

  .ai-dual-card-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_font_size }}px;
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    font-weight: {{ block.settings.title_font_weight }};
  }

  .ai-dual-card-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-dual-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-dual-cards-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-dual-card-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_card_width }}%;
      min-height: {{ block.settings.mobile_card_height }}px;
    }

    .ai-dual-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_font_size }}px;
    }

    .ai-dual-card-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_font_size }}px;
    }
  }
{% endstyle %}

<div class="ai-dual-cards-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dual-cards-container-{{ ai_gen_id }}">
    <div class="ai-dual-card-{{ ai_gen_id }}">
      {% if block.settings.card_1_image %}
        <img
          src="{{ block.settings.card_1_image | image_url: width: 1200 }}"
          alt="{{ block.settings.card_1_image.alt | escape }}"
          class="ai-dual-card-background-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.card_1_image.width }}"
          height="{{ block.settings.card_1_image.height }}"
        >
      {% endif %}
      <div class="ai-dual-card-overlay-1-{{ ai_gen_id }}"></div>
      <div class="ai-dual-card-content-{{ ai_gen_id }}">
        {% if block.settings.card_1_title != blank %}
          <h2 class="ai-dual-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h2>
        {% endif %}
        {% if block.settings.card_1_button_text != blank %}
          <a href="{{ block.settings.card_1_button_link }}" class="ai-dual-card-button-{{ ai_gen_id }}">
            {{ block.settings.card_1_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-dual-card-{{ ai_gen_id }}">
      {% if block.settings.card_2_image %}
        <img
          src="{{ block.settings.card_2_image | image_url: width: 1200 }}"
          alt="{{ block.settings.card_2_image.alt | escape }}"
          class="ai-dual-card-background-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.card_2_image.width }}"
          height="{{ block.settings.card_2_image.height }}"
        >
      {% endif %}
      <div class="ai-dual-card-overlay-2-{{ ai_gen_id }}"></div>
      <div class="ai-dual-card-content-{{ ai_gen_id }}">
        {% if block.settings.card_2_title != blank %}
          <h2 class="ai-dual-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h2>
        {% endif %}
        {% if block.settings.card_2_button_text != blank %}
          <a href="{{ block.settings.card_2_button_link }}" class="ai-dual-card-button-{{ ai_gen_id }}">
            {{ block.settings.card_2_button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

