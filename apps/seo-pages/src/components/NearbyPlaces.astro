---
import type { NearbyPlace } from '../lib/places';

interface Props {
  places: NearbyPlace[];
}

const { places } = Astro.props;
---
{places.length > 0 && (
  <section class="nearby-section">
    <div class="section-label">Lieux à proximité</div>
    <div class="nearby-grid">
      {places.map((place) => (
        <a href={`/lieu/${place.slug}`} class="nearby-card">
          <div class="nearby-card-visual">
            {place.images?.[0]?.url ? (
              <img
                src={place.images[0].thumb || place.images[0].url}
                alt={place.title}
                loading="lazy"
                class="nearby-card-img"
              />
            ) : (
              <div class="nearby-card-img nearby-card-placeholder" />
            )}
            <div class="nearby-card-overlay">
              {place.primaryTag && (
                <span
                  class="nearby-card-tag"
                  style={`color: ${place.primaryTag.color}; background: ${place.primaryTag.background};`}
                >
                  {place.primaryTag.icon && (
                    <span
                      class="nearby-card-tag-icon"
                      style={`background-color: ${place.primaryTag.color}; -webkit-mask-image: url(${place.primaryTag.icon}); mask-image: url(${place.primaryTag.icon});`}
                    />
                  )}
                  {place.primaryTag.title}
                </span>
              )}
              <span class="nearby-card-name">{place.title}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
