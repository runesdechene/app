              {%- assign title_text_align_m = 'center' -%}
            {%- elsif title_align_m == 'right' -%}
              {%- assign title_align_css_m = 'flex-end' -%}
              {%- assign title_text_align_m = 'right' -%}
            {%- else -%}
              {%- assign title_align_css_m = 'flex-start' -%}
              {%- assign title_text_align_m = 'left' -%}
            {%- endif -%}

            {%- assign show_title_area_m = false -%}
