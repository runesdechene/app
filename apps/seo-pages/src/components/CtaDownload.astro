---
interface Props {
  placeName: string;
}

const { placeName } = Astro.props;
---

<section style="background: url('https://runesdechene.com/cdn/shop/files/fond_newsletter_49315af4-ed7c-4592-8da4-8453b9b08ea7.webp') center/cover; position: relative; padding: 4rem 2rem; text-align: center;">
  <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.6);"></div>
  <div style="position: relative; z-index: 1;">
    <h2 style="font-size: 1.8rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem;">
      Explorez {placeName} sur l'app
    </h2>
    <p style="color: rgba(255,255,255,0.55); font-size: 0.95rem; margin-bottom: 2rem; max-width: 420px; margin-left: auto; margin-right: auto;">
      Rejoignez les explorateurs qui documentent le patrimoine français. Gratuite, sans pub.
    </p>
    <a href="https://carte.runesdechene.com" style="display: inline-block; background: var(--accent); color: #fff; padding: 0.85rem 2.5rem; border-radius: 6px; font-family: var(--font-accent); font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none;">
      Télécharger l'application
    </a>
  </div>
</section>
