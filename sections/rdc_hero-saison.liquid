{%- comment -%}
  rdc_hero-saison.liquid

  Modal popup saisonnière de la home Boutique.
  S'affiche au-dessus du contenu existant après X secondes.
  Spec : docs/superpowers/specs/2026-04-23-hero-saison-home-design.md
{%- endcomment -%}

{%- liquid
  assign overlay_r = section.settings.overlay_color | color_extract: 'red'
  assign overlay_g = section.settings.overlay_color | color_extract: 'green'
  assign overlay_b = section.settings.overlay_color | color_extract: 'blue'
  assign overlay_strength = section.settings.overlay_strength
  assign overlay_blur = section.settings.overlay_blur
  assign backdrop_r = section.settings.backdrop_color | color_extract: 'red'
  assign backdrop_g = section.settings.backdrop_color | color_extract: 'green'
  assign backdrop_b = section.settings.backdrop_color | color_extract: 'blue'
  assign backdrop_strength = section.settings.backdrop_strength
  assign backdrop_blur = section.settings.backdrop_blur
  assign text_r = section.settings.text_color | color_extract: 'red'
  assign text_g = section.settings.text_color | color_extract: 'green'
  assign text_b = section.settings.text_color | color_extract: 'blue'
  assign title_r = section.settings.title_color | color_extract: 'red'
  assign title_g = section.settings.title_color | color_extract: 'green'
  assign title_b = section.settings.title_color | color_extract: 'blue'
  assign cta_primary_r = section.settings.cta_primary_color | color_extract: 'red'
  assign cta_primary_g = section.settings.cta_primary_color | color_extract: 'green'
  assign cta_primary_b = section.settings.cta_primary_color | color_extract: 'blue'
  assign perk_1_r = section.settings.perk_1_color | color_extract: 'red'
  assign perk_1_g = section.settings.perk_1_color | color_extract: 'green'
  assign perk_1_b = section.settings.perk_1_color | color_extract: 'blue'
  assign perk_2_r = section.settings.perk_2_color | color_extract: 'red'
  assign perk_2_g = section.settings.perk_2_color | color_extract: 'green'
  assign perk_2_b = section.settings.perk_2_color | color_extract: 'blue'
  assign ken_burns_class = ''
  if section.settings.enable_ken_burns
    assign ken_burns_class = ' rdc-hero__media--ken-burns'
  endif
  assign popup_delay = section.settings.popup_delay | default: 3
  assign popup_storage_key = section.settings.popup_storage_key | default: 'rdc_hero_seen'
  assign popup_show_once = section.settings.popup_show_once
  assign modal_max_width = section.settings.modal_max_width | default: 820
  assign modal_padding_block = section.settings.modal_padding_block | default: 60
  assign modal_padding_inline = section.settings.modal_padding_inline | default: 40
  assign taglines_max_width = section.settings.taglines_max_width | default: 480
-%}

{%- if section.settings.reopen_enable -%}
  <button type="button" class="rdc-hero__reopen" data-rdc-hero-reopen data-rdc-hero-target="RdcHeroSaison-{{ section.id }}" aria-label="Rouvrir la popup" style="--rdc-hero-cta-primary-rgb: {{ cta_primary_r }}, {{ cta_primary_g }}, {{ cta_primary_b }}; --rdc-hero-cta-primary-color: rgb({{ cta_primary_r }}, {{ cta_primary_g }}, {{ cta_primary_b }});">
    {%- if section.settings.reopen_image != blank -%}
      {{ section.settings.reopen_image | image_url: width: 200 | image_tag: alt: '', class: 'rdc-hero__reopen-img', loading: 'lazy' }}
    {%- else -%}
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="5" y="2" width="14" height="20" rx="2.5" ry="2.5"></rect>
        <line x1="12" y1="18.5" x2="12.01" y2="18.5"></line>
      </svg>
    {%- endif -%}
  </button>
{%- endif -%}

<div
  id="RdcHeroSaison-{{ section.id }}"
  class="rdc-hero color-{{ section.settings.color_scheme }}"
  role="dialog"
  aria-modal="true"
  aria-labelledby="RdcHeroSaison-title-{{ section.id }}"
  aria-hidden="true"
  data-popup-delay="{{ popup_delay }}"
  data-popup-storage-key="{{ popup_storage_key }}"
  data-popup-show-once="{{ popup_show_once }}"
  style="--rdc-hero-overlay-rgb: {{ overlay_r }}, {{ overlay_g }}, {{ overlay_b }}; --rdc-hero-overlay-strength: {{ overlay_strength }}; --rdc-hero-overlay-blur: {{ overlay_blur }}px; --rdc-hero-backdrop-rgb: {{ backdrop_r }}, {{ backdrop_g }}, {{ backdrop_b }}; --rdc-hero-backdrop-strength: {{ backdrop_strength }}; --rdc-hero-backdrop-blur: {{ backdrop_blur }}px; --rdc-hero-modal-max-width: {{ modal_max_width }}px; --rdc-hero-modal-padding-block: {{ modal_padding_block }}px; --rdc-hero-modal-padding-inline: {{ modal_padding_inline }}px; --rdc-hero-text-rgb: {{ text_r }}, {{ text_g }}, {{ text_b }}; --rdc-hero-text-color: rgb({{ text_r }}, {{ text_g }}, {{ text_b }}); --rdc-hero-title-color: rgb({{ title_r }}, {{ title_g }}, {{ title_b }}); --rdc-hero-cta-primary-rgb: {{ cta_primary_r }}, {{ cta_primary_g }}, {{ cta_primary_b }}; --rdc-hero-cta-primary-color: rgb({{ cta_primary_r }}, {{ cta_primary_g }}, {{ cta_primary_b }}); --rdc-hero-taglines-max-width: {{ taglines_max_width }}px;"
>
  <div class="rdc-hero__backdrop" data-rdc-hero-close></div>

  <div class="rdc-hero__modal" role="document">
    <button
      type="button"
      class="rdc-hero__close"
      aria-label="Fermer"
      data-rdc-hero-close
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="rdc-hero__media{{ ken_burns_class }}">
      {%- if section.settings.image_desktop != blank or section.settings.image_mobile != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.image_mobile | image_url: width: 600 }} 600w,
                {{ section.settings.image_mobile | image_url: width: 900 }} 900w,
                {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w
              "
              sizes="100vw"
              width="{{ section.settings.image_mobile.width }}"
              height="{{ section.settings.image_mobile.height }}"
            >
          {%- endif -%}
          {%- if section.settings.image_desktop != blank -%}
            {{
              section.settings.image_desktop
              | image_url: width: 1920
              | image_tag:
                widths: '600, 900, 1200, 1600, 1920',
                width: section.settings.image_desktop.width,
                height: section.settings.image_desktop.height,
                alt: section.settings.image_alt,
                sizes: '(min-width: 750px) 90vw, 100vw',
                loading: 'eager',
                class: 'rdc-hero__image'
            }}
          {%- elsif section.settings.image_mobile != blank -%}
            {{
              section.settings.image_mobile
              | image_url: width: 1200
              | image_tag:
                widths: '600, 900, 1200',
                width: section.settings.image_mobile.width,
                height: section.settings.image_mobile.height,
                alt: section.settings.image_alt,
                sizes: '100vw',
                loading: 'eager',
                class: 'rdc-hero__image'
            }}
          {%- endif -%}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'rdc-hero__image rdc-hero__image--placeholder' }}
      {%- endif -%}
    </div>

    {%- if section.settings.frame_image != blank or section.settings.frame_image_mobile != blank -%}
      <div class="rdc-hero__frame" style="--rdc-hero-frame-opacity: {{ section.settings.frame_opacity | default: 100 | divided_by: 100.0 }};" aria-hidden="true">
        <picture>
          {%- if section.settings.frame_image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.frame_image_mobile | image_url: width: 600 }} 600w,
                {{ section.settings.frame_image_mobile | image_url: width: 900 }} 900w,
                {{ section.settings.frame_image_mobile | image_url: width: 1200 }} 1200w
              "
              sizes="100vw"
              width="{{ section.settings.frame_image_mobile.width }}"
              height="{{ section.settings.frame_image_mobile.height }}"
            >
          {%- endif -%}
          {%- if section.settings.frame_image != blank -%}
            {{
              section.settings.frame_image
              | image_url: width: 1920
              | image_tag:
                widths: '600, 900, 1200, 1600, 1920',
                width: section.settings.frame_image.width,
                height: section.settings.frame_image.height,
                alt: '',
                sizes: '(min-width: 750px) 90vw, 100vw',
                loading: 'eager',
                class: 'rdc-hero__frame-img'
            }}
          {%- elsif section.settings.frame_image_mobile != blank -%}
            {{
              section.settings.frame_image_mobile
              | image_url: width: 1200
              | image_tag:
                widths: '600, 900, 1200',
                width: section.settings.frame_image_mobile.width,
                height: section.settings.frame_image_mobile.height,
                alt: '',
                sizes: '100vw',
                loading: 'eager',
                class: 'rdc-hero__frame-img'
            }}
          {%- endif -%}
        </picture>
      </div>
    {%- endif -%}

    <div class="rdc-hero__overlay" aria-hidden="true"></div>

    <div class="rdc-hero__content">
      <div class="rdc-hero__top">
        {%- if section.settings.top_image != blank -%}
          <div class="rdc-hero__top-image" style="--rdc-hero-top-image-max-width: {{ section.settings.top_image_max_width | default: 140 }}px;">
            {{ section.settings.top_image | image_url: width: 600 | image_tag: alt: '', class: 'rdc-hero__top-image-img', loading: 'eager' }}
          </div>
        {%- endif -%}
        {%- if section.settings.overline != blank -%}
          <p class="rdc-hero__overline">{{ section.settings.overline | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="RdcHeroSaison-title-{{ section.id }}" class="rdc-hero__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <div class="rdc-hero__subtitle">{{ section.settings.subtitle }}</div>
        {%- endif -%}
        {%- if section.settings.pitch != blank -%}
          <p class="rdc-hero__pitch">{{ section.settings.pitch | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.perk_1_text != blank or section.settings.perk_2_text != blank -%}
        <div class="rdc-hero__perks">
          {%- if section.settings.perk_1_text != blank -%}
            <span class="rdc-hero__perk" style="--perk-color: rgb({{ perk_1_r }}, {{ perk_1_g }}, {{ perk_1_b }}); --perk-rgb: {{ perk_1_r }}, {{ perk_1_g }}, {{ perk_1_b }};">
              <svg class="rdc-hero__perk-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
              <span>{{ section.settings.perk_1_text | escape }}</span>
            </span>
          {%- endif -%}
          {%- if section.settings.perk_2_text != blank -%}
            <span class="rdc-hero__perk" style="--perk-color: rgb({{ perk_2_r }}, {{ perk_2_g }}, {{ perk_2_b }}); --perk-rgb: {{ perk_2_r }}, {{ perk_2_g }}, {{ perk_2_b }};">
              <svg class="rdc-hero__perk-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
              <span>{{ section.settings.perk_2_text | escape }}</span>
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.cta_primary_label != blank or section.settings.cta_secondary_label != blank -%}
        <div class="rdc-hero__ctas">
          {%- if section.settings.cta_primary_label != blank -%}
            <a
              href="{{ section.settings.cta_primary_url | default: '#' }}"
              class="rdc-hero__cta rdc-hero__cta--primary button"
            >
              <svg class="rdc-hero__cta-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5" y="2" width="14" height="20" rx="2.5" ry="2.5"></rect>
                <line x1="12" y1="18.5" x2="12.01" y2="18.5"></line>
              </svg>
              <span>{{ section.settings.cta_primary_label | escape }}</span>
            </a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_label != blank -%}
            <a
              href="{{ section.settings.cta_secondary_url | default: '#' }}"
              class="rdc-hero__cta rdc-hero__cta--secondary button button-secondary"
            >
              <span>{{ section.settings.cta_secondary_label | escape }}</span>
              <svg class="rdc-hero__cta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="rdc-hero__taglines" data-rdc-tagline-slideshow>
          <div class="rdc-hero__taglines-track">
            {%- for block in section.blocks -%}
              {%- if block.type == 'tagline' -%}
                <p class="rdc-hero__tagline rdc-hero__tagline--slide{% if forloop.first %} is-active{% endif %}"
                   data-tagline-index="{{ forloop.index0 }}"
                   {{ block.shopify_attributes }}>« {{ block.settings.text | escape }} »</p>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if section.blocks.size > 1 -%}
            <div class="rdc-hero__taglines-dots" role="tablist" aria-label="Sélection des taglines">
              {%- for block in section.blocks -%}
                {%- if block.type == 'tagline' -%}
                  <button type="button"
                          class="rdc-hero__taglines-dot{% if forloop.first %} is-active{% endif %}"
                          data-dot-index="{{ forloop.index0 }}"
                          aria-label="Tagline {{ forloop.index }}"
                          role="tab"
                          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"></button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .rdc-hero {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3vw, 2rem);
    color: var(--rdc-hero-text-color, #2a2418);
    pointer-events: none;
    background: transparent !important;
  }

  .rdc-hero-section,
  .shopify-section:has(> .rdc-hero) {
    background: transparent !important;
  }

  .rdc-hero.is-open {
    display: flex;
    pointer-events: auto;
    animation: rdcHeroFadeIn 0.4s ease-out;
    backdrop-filter: blur(var(--rdc-hero-backdrop-blur, 10px)) saturate(1.1);
    -webkit-backdrop-filter: blur(var(--rdc-hero-backdrop-blur, 10px)) saturate(1.1);
  }

  @keyframes rdcHeroFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .rdc-hero__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(var(--rdc-hero-backdrop-rgb, 245, 240, 230));
    opacity: calc(var(--rdc-hero-backdrop-strength, 40) / 100);
    cursor: pointer;
  }

  /* Modal box : on garde l'ombre de la modal elle-même (sépare visuellement du backdrop). */
  .rdc-hero__modal {
    position: relative;
    width: 100%;
    max-width: var(--rdc-hero-modal-max-width, 820px);
    height: auto;
    max-height: 90vh;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35), 0 8px 16px rgba(0, 0, 0, 0.18);
    isolation: isolate;
    display: flex;
    flex-direction: column;
    animation: rdcHeroModalIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes rdcHeroModalIn {
    from { opacity: 0; transform: translateY(20px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .rdc-hero__close {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    z-index: 10;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--rdc-hero-text-rgb, 42, 36, 24), 0.55);
    color: #d3cccc;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.2s ease, transform 0.2s ease;
    padding: 0;
  }

  .rdc-hero__close:hover {
    background: rgba(var(--rdc-hero-text-rgb, 42, 36, 24), 0.8);
    transform: scale(1.05);
  }

  .rdc-hero__close:focus-visible {
    outline: 2px solid var(--rdc-hero-text-color, #2a2418);
    outline-offset: 2px;
  }

  .rdc-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .rdc-hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .rdc-hero__image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center center;
    display: block;
    max-width: none !important;
  }

  .rdc-hero__media--ken-burns .rdc-hero__image {
    animation: rdcHeroKenBurns 20s ease-in-out infinite alternate !important;
    transform-origin: center center !important;
    will-change: transform;
  }

  @keyframes rdcHeroKenBurns {
    from { transform: scale(1.00); }
    to   { transform: scale(1.18); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rdc-hero__media--ken-burns .rdc-hero__image,
    .rdc-hero.is-open,
    .rdc-hero__modal {
      animation: none;
    }
  }

  /* Frame image (parchemin déchiré PNG) : par-dessus l'image animée, statique */
  .rdc-hero__frame {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: var(--rdc-hero-frame-opacity, 1);
  }

  .rdc-hero__frame picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .rdc-hero__frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .rdc-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        to top,
        rgba(var(--rdc-hero-overlay-rgb), calc(var(--rdc-hero-overlay-strength) / 100)) 0%,
        rgba(var(--rdc-hero-overlay-rgb), calc(var(--rdc-hero-overlay-strength) / 200)) 50%,
        rgba(var(--rdc-hero-overlay-rgb), calc(var(--rdc-hero-overlay-strength) / 350)) 100%
      );
    backdrop-filter: blur(var(--rdc-hero-overlay-blur));
    -webkit-backdrop-filter: blur(var(--rdc-hero-overlay-blur));
    pointer-events: none;
  }

  .rdc-hero__content {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-block: var(--rdc-hero-modal-padding-block, 60px);
    padding-inline: var(--rdc-hero-modal-padding-inline, 40px);
    gap: 1.25rem;
    pointer-events: none;
    text-align: left;
  }

  .rdc-hero__content > * {
    pointer-events: auto;
  }

  .rdc-hero__top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 58%;
    margin: 0;
  }

  .rdc-hero__top-image {
    display: flex;
    justify-content: flex-start;
    width: 100%;
    max-width: var(--rdc-hero-top-image-max-width, 140px);
    margin: 0 0 0.25rem 0;
  }

  .rdc-hero__top-image-img {
    width: 100%;
    height: auto;
    max-width: 100%;
  }

  .rdc-hero__overline {
    margin: 1.25rem 0 -0.8rem;
    padding-top: 20px;
    font-family: var(--font-heading--family);
    font-size: 1.4rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rdc-hero-text-color, #2a2418);
    font-weight: 600;
  }

  .rdc-hero__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: 0.005em;
    font-weight: 700;
    color: var(--rdc-hero-title-color, var(--rdc-hero-text-color, #2a2418));
    text-wrap: balance;
  }

  .rdc-hero__subtitle {
    margin-top: 0.5rem;
    font-family: var(--font-body--family);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.55;
    color: var(--rdc-hero-text-color, #2a2418);
    opacity: 0.92;
    max-width: 540px;
    font-weight: 400;
  }

  .rdc-hero__subtitle > * {
    margin: 0;
  }

  .rdc-hero__pitch {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    color: var(--rdc-hero-text-color, #2a2418);
    max-width: 540px;
    font-weight: 600;
  }

  /* Perks : 2 gélules colorées au-dessus des CTAs, expliquent les bonus dans l'app */
  .rdc-hero__perks {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
    align-items: flex-start;
  }

  .rdc-hero__perk {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4rem 0.8rem;
    font-family: var(--font-body--family);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--perk-color, #c8956b);
    background-color: rgba(var(--perk-rgb, 200, 149, 107), 0.14);
