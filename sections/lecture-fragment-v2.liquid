      "info": "Grande illustration affichée à droite du texte"
    },
    {
      "type": "header",
      "content": "Image de fond"
    },
    {
      "type": "image_picker",
      "id": "background_image_metaobject",
      "label": "Image de fond depuis le métaobjet",
      "info": "Sélectionnez une image depuis le métaobjet illustration_produit. Prioritaire sur l'image par défaut ci-dessous."
