{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .rdc-grid-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ section.settings.gap }}px;
    justify-content: center;
    margin: 0 auto;
  {% if section.settings.width_mode == 'full' %}
  max-width: 100%;
  padding: 0 5vw;
{% elsif section.settings.width_mode == 'custom' %}
  max-width: {{ section.settings.custom_width }}px;
  padding: 0 1.5rem;
{% endif %}

  }

  .rdc-item-{{ section.id }} {
    flex: 1 1 calc(25% - {{ section.settings.gap }}px);
    display: flex;
    flex-direction: column;
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-sizing: border-box;
  }

  .rdc-item-{{ section.id }}:hover {
    transform: scale({{ section.settings.hover_scale | divided_by: 100.0 }});
    z-index: 2;
  }

  /* --- HARD RESET DES MARGES THEME --- */
  .rdc-item-{{ section.id }} h1, .rdc-item-{{ section.id }} h2, .rdc-item-{{ section.id }} h3, 
  .rdc-item-{{ section.id }} h4, .rdc-item-{{ section.id }} p, .rdc-item-{{ section.id }} .rte p {
    margin: 0 !important;
    padding: 0 !important;
  }

  @media screen and (max-width: 749px) {
    {% if section.settings.enable_mobile_carousel %}
      .rdc-grid-{{ section.id }} {
        flex-wrap: nowrap !important;
        overflow-x: auto !important;
        scroll-snap-type: x mandatory !important;
        scrollbar-width: none !important;
        justify-content: flex-start !important;
        gap: 0 !important;
        scroll-behavior: smooth !important;
        -webkit-overflow-scrolling: touch !important;
        padding: 0 !important;
      }
      .rdc-grid-{{ section.id }}::-webkit-scrollbar { display: none; }
      .rdc-grid-{{ section.id }}::before, .rdc-grid-{{ section.id }}::after {
        content: '';
        flex: 0 0 calc((100% - {{ section.settings.mobile_item_width }}%) / 2);
      }
      .rdc-item-{{ section.id }} {
        flex: 0 0 {{ section.settings.mobile_item_width }}% !important;
        width: {{ section.settings.mobile_item_width }}% !important;
        scroll-snap-align: center;
        flex-shrink: 0;
        padding: 0 10px;
      }
    {% endif %}
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="rdc-grid-{{ section.id }}{% if section.settings.width_mode == 'page' %} page-width{% endif %}" id="Slider-{{ section.id }}">

    {%- for block in section.blocks -%}
      {%- style -%}
        .block-{{ block.id }} {
          align-items: {{ block.settings.alignment }};
          text-align: {{ block.settings.alignment }};
        }
        /* Image */
        .block-{{ block.id }} .img-wrapper {
            margin-top: {{ block.settings.img_m_t }}px !important;
            margin-bottom: {{ block.settings.img_m_b }}px !important;
        }
        .block-{{ block.id }} img {
          width: {{ block.settings.icon_width }}px !important;
          border-radius: {{ block.settings.image_radius }}px !important;
          opacity: {{ block.settings.img_opacity | divided_by: 100.0 }} !important;
          transition: opacity 0.3s ease;
          display: block;
        }
        .block-{{ block.id }}:hover img { opacity: 1 !important; }

        /* Titre - Forçage des marges dynamiques */
        .block-{{ block.id }} .rdc-title {
          max-width: {{ block.settings.title_max_width }}% !important;
          margin-top: {{ block.settings.title_m_t }}px !important;
          margin-bottom: {{ block.settings.title_m_b }}px !important;
          padding-left: {{ block.settings.title_p_l }}px !important;
          padding-right: {{ block.settings.title_p_r }}px !important;
          {% if block.settings.use_custom_color %}color: {{ block.settings.title_color }} !important;{% endif %}
          {% if block.settings.override_title_size %}font-size: {{ block.settings.title_size }}px !important;{% endif %}
          line-height: 1.1 !important;
        }

        /* Texte - Suppression du GAP anormal */
        .block-{{ block.id }} .rdc-text {
          max-width: {{ block.settings.text_max_width }}% !important;
          margin-top: {{ block.settings.text_m_t }}px !important;
          margin-bottom: {{ block.settings.text_m_b }}px !important;
          padding-left: {{ block.settings.text_p_l }}px !important;
          padding-right: {{ block.settings.text_p_r }}px !important;
          {% if block.settings.use_custom_color %}color: {{ block.settings.text_color }} !important;{% endif %}
          {% if block.settings.override_text_size %}font-size: {{ block.settings.text_size }}px !important;{% endif %}
          line-height: 1.3 !important;
        }
      {%- endstyle -%}

      <div class="rdc-item-{{ section.id }} block-{{ block.id }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="img-wrapper">
            <img src="{{ block.settings.image | img_url: '400x' }}" alt="{{ block.settings.title }}" loading="lazy">
          </div>
        {%- endif -%}
        
        {%- if block.settings.title != blank -%}
          <{{ block.settings.title_tag }} class="rdc-title {{ block.settings.title_tag }}">
            {{ block.settings.title }}
          </{{ block.settings.title_tag }}>
        {%- endif -%}
        
        <div class="rdc-text rte">
          {{ block.settings.text }}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% if section.settings.enable_mobile_carousel and section.settings.autoplay %}
<script>
  (function() {
    const initSlider = () => {
      const grid = document.getElementById('Slider-{{ section.id }}');
      if (!grid || window.innerWidth > 749) return;
      const items = grid.querySelectorAll('.rdc-item-{{ section.id }}');
      if (items.length <= 1) return;
      let currentIndex = 0;
      setInterval(() => {
        currentIndex = (currentIndex + 1) % items.length;
       const item = items[currentIndex];

// scroll uniquement dans le conteneur
const left = item.offsetLeft - grid.offsetLeft;

grid.scrollTo({
  left: left - (grid.clientWidth / 2) + (item.clientWidth / 2),
  behavior: 'smooth'
});
      }, {{ section.settings.autoplay_speed | times: 1000 }});
    };
    document.addEventListener('DOMContentLoaded', initSlider);
    if (window.shopify) document.addEventListener('shopify:section:load', initSlider);
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "RDC - Réassurance",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Nuancier Boutique", "default": "background-1" },
    { "type": "select", "id": "width_mode", "label": "Largeur de la section", "options": [
        { "value": "page", "label": "Largeur site (standard)" },
        { "value": "full", "label": "Pleine largeur (100%)" },
        { "value": "custom", "label": "Largeur personnalisée" }
      ], "default": "page" },
    { "type": "range", "id": "custom_width", "min": 400, "max": 1600, "step": 20, "unit": "px", "label": "Valeur largeur personnalisée", "default": 1200 },
    { "type": "range", "id": "gap", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Espace entre blocs", "default": 20 },
    { "type": "range", "id": "hover_scale", "min": 100, "max": 130, "step": 1, "unit": "%", "label": "Zoom au survol", "default": 110 },
    { "type": "header", "content": "Mobile" },
    { "type": "range", "id": "mobile_item_width", "min": 30, "max": 100, "step": 5, "unit": "%", "label": "Largeur bloc mobile (%)", "default": 80 },
    { "type": "checkbox", "id": "enable_mobile_carousel", "label": "Activer carrousel", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Défilement auto", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Vitesse", "default": 4 },
    { "type": "header", "content": "Espacement Section" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge Haut", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge Bas", "default": 40 }
  ],
  "blocks": [
    {
      "type": "icon_block",
      "name": "Bloc Icône",
      "settings": [
        { "type": "header", "content": "Contenu" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Titre", "default": "TITRE" },
        { "type": "richtext", "id": "text", "label": "Paragraphe", "default": "<p>Description.</p>" },
        { "type": "select", "id": "alignment", "label": "Alignement global", "options": [
            { "value": "flex-start", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "flex-end", "label": "Droite" }
          ], "default": "center" },
        { "type": "header", "content": "Style Photo" },
        { "type": "range", "id": "icon_width", "min": 30, "max": 400, "step": 5, "unit": "px", "label": "Largeur", "default": 80 },
        { "type": "range", "id": "img_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacité", "default": 100 },
        { "type": "range", "id": "image_radius", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Arrondi", "default": 60 },
        { "type": "range", "id": "img_m_t", "min": 0, "max": 100, "step": 1, "label": "Marge Haut", "default": 0 },
        { "type": "range", "id": "img_m_b", "min": 0, "max": 100, "step": 1, "label": "Marge Bas (GAP Titre)", "default": 20 },
        { "type": "header", "content": "Style Titre" },
        { "type": "select", "id": "title_tag", "label": "Balise Typo", "options": [
            { "value": "h1", "label": "Titre 1" }, { "value": "h2", "label": "Titre 2" }, { "value": "h3", "label": "Titre 3" }, { "value": "h4", "label": "Titre 4" }, { "value": "p", "label": "Paragraphe" }
          ], "default": "h3" },
        { "type": "range", "id": "title_max_width", "min": 10, "max": 100, "step": 5, "unit": "%", "label": "Largeur max", "default": 100 },
        { "type": "range", "id": "title_m_t", "min": -50, "max": 50, "step": 1, "label": "Marge Haut", "default": 0 },
        { "type": "range", "id": "title_m_b", "min": -50, "max": 50, "step": 1, "label": "Marge Bas (GAP Texte)", "default": 10 },
        { "type": "range", "id": "title_p_l", "min": 0, "max": 100, "step": 1, "label": "Padding Gauche", "default": 0 },
        { "type": "range", "id": "title_p_r", "min": 0, "max": 100, "step": 1, "label": "Padding Droite", "default": 0 },
        { "type": "checkbox", "id": "override_title_size", "label": "Forcer taille", "default": false },
        { "type": "range", "id": "title_size", "min": 8, "max": 100, "step": 1, "unit": "px", "label": "Valeur Taille", "default": 20 },
        { "type": "header", "content": "Style Paragraphe" },
        { "type": "range", "id": "text_max_width", "min": 10, "max": 100, "step": 5, "unit": "%", "label": "Largeur max", "default": 100 },
        { "type": "range", "id": "text_m_t", "min": -50, "max": 50, "step": 1, "label": "Marge Haut (Resserrer GAP)", "default": 0 },
        { "type": "range", "id": "text_m_b", "min": -50, "max": 50, "step": 1, "label": "Marge Bas", "default": 0 },
        { "type": "range", "id": "text_p_l", "min": 0, "max": 100, "step": 1, "label": "Padding Gauche", "default": 0 },
        { "type": "range", "id": "text_p_r", "min": 0, "max": 100, "step": 1, "label": "Padding Droite", "default": 0 },
        { "type": "checkbox", "id": "override_text_size", "label": "Forcer taille", "default": false },
        { "type": "range", "id": "text_size", "min": 8, "max": 100, "step": 1, "unit": "px", "label": "Valeur Taille", "default": 14 },
        { "type": "header", "content": "Couleurs Override" },
        { "type": "checkbox", "id": "use_custom_color", "label": "Activer couleurs perso", "default": false },
        { "type": "color", "id": "title_color", "label": "Couleur Titre", "default": "#ffffff" },
        { "type": "color", "id": "text_color", "label": "Couleur Texte", "default": "#ffffff" }
      ]
    }
  ],
  "presets": [
    { "name": "RDC - Réassurance", "blocks": [{ "type": "icon_block" },{ "type": "icon_block" },{ "type": "icon_block" }] }
  ]
}
{% endschema %}