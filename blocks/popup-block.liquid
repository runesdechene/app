      "id": "title_preset",
      "label": "Style du titre",
      "options": [
        {
          "value": "",
          "label": "Par défaut"
        },
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Description du bloc</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#ffffff",
      "info": "Couleur du titre, description et bouton"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texte du bouton",
      "default": "En savoir plus"
    },
    {
      "type": "header",
      "content": "Action du bloc"
    },
    {
      "type": "select",
      "id": "link_type",
      "label": "Type de lien",
      "options": [
        {
          "value": "popup",
          "label": "Ouvrir un pop-up"
