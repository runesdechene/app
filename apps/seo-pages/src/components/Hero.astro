---
interface Props {
  title: string;
  placeType: string;
  address: string;
  imageUrl: string | null;
}

const { title, placeType, address, imageUrl } = Astro.props;
---

<section style="position: relative; min-height: 50vh; display: flex; align-items: flex-end;">
  {imageUrl && (
    <img
      src={imageUrl}
      alt={title}
      loading="eager"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;"
    />
  )}
  <div style="position: absolute; inset: 0; background: linear-gradient(transparent 40%, rgba(10,10,10,0.95)); z-index: 1;"></div>
  <div class="container" style="position: relative; z-index: 2; padding-bottom: 2rem;">
    <p style="color: var(--color-accent); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">
      {placeType}
    </p>
    <h1>{title}</h1>
    {address && <p style="color: var(--color-muted); margin-top: 0.5rem;">{address}</p>}
  </div>
</section>
