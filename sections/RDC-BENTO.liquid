{%- style -%}
/* ============================================
   RDC — Bento Collection List
============================================ */

.rdc-bento-{{ section.id }} {
  margin-top: {{ section.settings.section_margin_top }}px;
  margin-bottom: {{ section.settings.section_margin_bottom }}px;
  padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
  background-color: rgba(var(--color-background), 1);
  color: rgba(var(--color-foreground), 1);
}

.rdc-bento-container-{{ section.id }} {
  margin: 0 auto;
}

{%- if section.settings.section_width == 'page' -%}
.rdc-bento-container-{{ section.id }} {
  max-width: var(--page-width, {{ section.settings.section_max_width }}px);
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}
{%- else -%}
.rdc-bento-container-{{ section.id }} {
  max-width: none;
  padding-left: {{ section.settings.section_padding_horizontal }}px;
  padding-right: {{ section.settings.section_padding_horizontal }}px;
}
{%- endif -%}

.rdc-bento-row-{{ section.id }} {
  display: flex;
  gap: {{ section.settings.cards_gap }}px;
  margin-bottom: {{ section.settings.cards_gap }}px;
  align-items: {{ section.settings.desktop_cards_vertical_align }};
}

.rdc-bento-row-{{ section.id }}:last-child {
  margin-bottom: 0;
}

.rdc-bento-row-{{ section.id }}.rdc-row-3equal > .rdc-bento-card-{{ section.id }},
.rdc-bento-row-{{ section.id }}.rdc-row-1full > .rdc-bento-card-{{ section.id }} {
  flex: 1;
}

.rdc-bento-card-{{ section.id }} {
  position: relative;
  border-radius: {{ section.settings.card_border_radius }}px;
  overflow: hidden;
  cursor: pointer;
  text-decoration: none;
  display: block;
  background-color: {{ section.settings.card_bg_color }};
  color: inherit;
  isolation: isolate;
}

.rdc-bento-card-img-wrap-{{ section.id }} {
  width: 100%;
  display: block;
  line-height: 0;
  position: relative;
  overflow: hidden;
  background-color: {{ section.settings.card_bg_color }};
}

.rdc-bento-card-img-wrap-{{ section.id }}::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, {{ section.settings.hover_overlay_opacity | divided_by: 100.0 }});
  opacity: 0;
  pointer-events: none;
  z-index: 2;
  transition: opacity 0.45s ease;
}

.rdc-bento-card-{{ section.id }} .rdc-bento-img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.7s cubic-bezier(0.165, 0.84, 0.44, 1), filter 0.7s ease, opacity 0.7s ease;
}

{%- if section.settings.desktop_image_max_height > 0 -%}
.rdc-bento-desktop-{{ section.id }} .rdc-bento-card-img-wrap-{{ section.id }} {
  max-height: {{ section.settings.desktop_image_max_height }}px;
}

.rdc-bento-desktop-{{ section.id }} .rdc-bento-card-{{ section.id }} .rdc-bento-img {
  max-height: {{ section.settings.desktop_image_max_height }}px;
  object-fit: {{ section.settings.desktop_image_fit }};
}
{%- endif -%}

{%- unless section.settings.disable_animation -%}
.rdc-bento-card-{{ section.id }}:not(.rdc-bento-brand-card-{{ section.id }}):hover .rdc-bento-img {
  transform: scale({{ section.settings.hover_zoom_scale | divided_by: 100.0 }});
  filter: saturate({{ section.settings.hover_saturation }}%);
}

.rdc-bento-card-{{ section.id }}:not(.rdc-bento-brand-card-{{ section.id }}):hover .rdc-bento-card-img-wrap-{{ section.id }}::after {
  opacity: 1;
}

.rdc-bento-brand-card-{{ section.id }}:hover .rdc-bento-brand-bg-image-{{ section.id }} {
  transform: scale(1.1);
}
{%- endunless -%}

/* --- Composition marque --- */
.rdc-bento-brand-card-{{ section.id }} .rdc-bento-card-img-wrap-{{ section.id }}::after {
  display: none;
}

.rdc-bento-brand-card-{{ section.id }} .rdc-bento-card-img-wrap-{{ section.id }} {
  background: transparent;
}

.rdc-bento-brand-bg-image-{{ section.id }} {
  position: relative;
  z-index: 0;
  filter: blur(var(--rdc-brand-bg-blur, 0px));
  transform: scale(1.06);
  opacity: var(--rdc-brand-bg-opacity, 1);
}

.rdc-bento-brand-overlay-{{ section.id }},
.rdc-bento-brand-gradient-left-{{ section.id }},
.rdc-bento-brand-gradient-right-{{ section.id }},
.rdc-bento-brand-motif-{{ section.id }} {
  position: absolute;
  pointer-events: none;
}

.rdc-bento-brand-overlay-{{ section.id }} {
  inset: 0;
  z-index: 1;
  background: var(--rdc-brand-overlay-color, #000000);
  opacity: var(--rdc-brand-overlay-opacity, 0.35);
}

.rdc-bento-brand-gradient-left-{{ section.id }} {
  top: 0;
  bottom: 0;
  left: 0;
  width: var(--rdc-brand-gradient-width, 30%);
  z-index: 2;
  background: linear-gradient(to right, var(--rdc-brand-gradient-color, #000000), transparent);
  opacity: var(--rdc-brand-gradient-opacity, 0.45);
}

.rdc-bento-brand-gradient-right-{{ section.id }} {
  top: 0;
  bottom: 0;
  right: 0;
  width: var(--rdc-brand-gradient-width, 30%);
  z-index: 2;
  background: linear-gradient(to left, var(--rdc-brand-gradient-color, #000000), transparent);
  opacity: var(--rdc-brand-gradient-opacity, 0.45);
}

.rdc-bento-brand-motif-{{ section.id }} {
  top: 0;
  bottom: 0;
  z-index: 3;
  width: auto;
  max-width: none;
  height: 100%;
  max-height: 100%;
  object-fit: contain;
  opacity: var(--rdc-brand-motif-opacity, 1);
  filter: blur(var(--rdc-brand-motif-blur, 0px));
}

.rdc-bento-brand-motif-left-{{ section.id }} {
  left: var(--rdc-brand-left-motif-offset-desktop, 0%);
  object-position: left center;
}

.rdc-bento-brand-motif-right-{{ section.id }} {
  right: var(--rdc-brand-right-motif-offset-desktop, 0%);
  object-position: right center;
}

.rdc-bento-brand-content-{{ section.id }} {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: {{ section.settings.title_padding }}px;
  text-align: center;
  pointer-events: none;
}

.rdc-bento-brand-title-image-{{ section.id }} {
  display: block;
  width: auto;
  height: auto;
  max-width: min(100%, var(--rdc-title-image-max-width, 420px));
  max-height: var(--rdc-title-image-max-height, 180px);
  object-fit: contain;
}

.rdc-bento-brand-title-text-{{ section.id }} {
  margin: 0;
  color: {{ section.settings.title_color_on_image }};
  font-size: clamp(22px, 3vw, 44px);
  font-weight: {{ section.settings.title_font_weight }};
  line-height: 1.1;
}

/* --- Badge --- */
.rdc-bento-badge-{{ section.id }} {
  position: absolute;
  top: {{ section.settings.badge_offset }}px;
  right: {{ section.settings.badge_offset }}px;
  z-index: 8;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 7px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  line-height: 1;
  overflow: hidden;
  background: var(--rdc-badge-bg);
  color: var(--rdc-badge-color);
}

.rdc-bento-badge-{{ section.id }}.rdc-badge-shine::before {
  content: "";
  position: absolute;
  top: -70%;
  right: -80%;
  width: 45%;
  height: 240%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.75), transparent);
  transform: translateX(160%) rotate(24deg);
  animation: rdc-badge-shine-{{ section.id }} 3.2s ease-in-out infinite;
}

@keyframes rdc-badge-shine-{{ section.id }} {
  0% {
    transform: translateX(180%) rotate(24deg);
  }
  42%, 100% {
    transform: translateX(-360%) rotate(24deg);
  }
}

/* --- Titres classiques --- */
.rdc-bento-title-overlay-{{ section.id }} {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: {{ section.settings.title_padding }}px;
  background: linear-gradient(to top, rgba(0,0,0,{{ section.settings.title_overlay_opacity | divided_by: 100.0 }}) 0%, transparent 100%);
  z-index: 4;
}

.rdc-bento-title-below-{{ section.id }} {
  padding: {{ section.settings.title_padding }}px;
}

.rdc-bento-title-content-{{ section.id }} {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: var(--rdc-title-image-align, flex-start);
}

.rdc-bento-title-overlay-{{ section.id }} .rdc-bento-title,
.rdc-bento-title-below-{{ section.id }} .rdc-bento-title {
  font-size: {{ section.settings.title_font_size }}px;
  font-weight: {{ section.settings.title_font_weight }};
  margin: 0;
  line-height: 1.2;
  width: 100%;
  text-align: var(--rdc-title-text-align, left);
}

.rdc-bento-title-overlay-{{ section.id }} .rdc-bento-title {
  color: {{ section.settings.title_color_on_image }};
}

.rdc-bento-title-below-{{ section.id }} .rdc-bento-title {
  color: {{ section.settings.title_color_below }};
}

.rdc-bento-card-title-image-{{ section.id }} {
  display: block;
  width: auto;
  height: auto;
  max-width: min(100%, var(--rdc-title-image-max-width, 260px));
  max-height: var(--rdc-title-image-max-height, 120px);
  object-fit: contain;
}

/* --- Collection à venir --- */
.rdc-bento-upcoming-card-{{ section.id }} {
  cursor: default;
}

.rdc-bento-upcoming-card-{{ section.id }} .rdc-bento-card-img-wrap-{{ section.id }} {
  min-height: 320px;
}

.rdc-bento-upcoming-card-{{ section.id }} .rdc-bento-img {
  filter: blur(var(--rdc-upcoming-blur, 0px));
  transform: scale(1.06);
  opacity: var(--rdc-upcoming-image-opacity, 1);
}

.rdc-bento-upcoming-content-{{ section.id }} {
  position: absolute;
  inset: 0;
  z-index: 5;
  padding: clamp(20px, 4vw, 44px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: var(--rdc-upcoming-content-align, center);
  text-align: var(--rdc-upcoming-text-align, center);
  color: #ffffff;
  isolation: isolate;
}

.rdc-bento-upcoming-content-{{ section.id }}::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: var(--rdc-upcoming-overlay-color, #000000);
  opacity: var(--rdc-upcoming-overlay-opacity, 0.35);
}

.rdc-bento-upcoming-title-{{ section.id }} {
  margin: 0 0 14px;
  font-size: clamp(24px, 3vw, 42px);
  line-height: 1.1;
  font-weight: 700;
  color: inherit;
}

.rdc-bento-upcoming-title-image-{{ section.id }} {
  display: flex;
  justify-content: var(--rdc-upcoming-title-image-align, center);
  width: 100%;
  margin-bottom: 18px;
}

.rdc-bento-upcoming-title-image-{{ section.id }} img {
  display: block;
  width: auto;
  height: auto;
  max-width: min(100%, var(--rdc-upcoming-title-image-max-width, 620px));
  max-height: var(--rdc-upcoming-title-image-max-height, 240px);
  object-fit: contain;
}

.rdc-bento-countdown-{{ section.id }} {
  display: flex;
  flex-direction: column;
  gap: 10px;
  align-items: inherit;
  margin-bottom: 18px;
}

.rdc-bento-countdown-intro-{{ section.id }} {
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0;
}

.rdc-bento-countdown-values-{{ section.id }} {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: center;
}

.rdc-bento-countdown-item-{{ section.id }} {
  min-width: 58px;
  padding: 8px 10px;
  border-radius: 8px;
  background: rgba(255,255,255,0.16);
  backdrop-filter: blur(8px);
}

.rdc-bento-countdown-number-{{ section.id }} {
  display: block;
  font-size: 22px;
  font-weight: 700;
  line-height: 1;
}

.rdc-bento-countdown-label-{{ section.id }} {
  display: block;
  margin-top: 4px;
  font-size: 10px;
  text-transform: uppercase;
}

.rdc-bento-upcoming-form-{{ section.id }} {
  width: min(100%, 420px);
}

.rdc-bento-upcoming-form-row-{{ section.id }} {
  display: flex;
  gap: 8px;
}

.rdc-bento-upcoming-input-{{ section.id }} {
  min-width: 0;
  flex: 1;
  min-height: 42px;
  border: 1px solid rgba(255,255,255,0.45);
  border-radius: 8px;
  padding: 0 12px;
  background: rgba(255,255,255,0.9);
  color: #111111;
}

.rdc-bento-upcoming-button-{{ section.id }} {
  min-height: 42px;
  border: 0;
  border-radius: 8px;
  padding: 0 16px;
  background: #ffffff;
  color: #111111;
  font-weight: 700;
  cursor: pointer;
}

.rdc-bento-upcoming-success-{{ section.id }} {
  margin: 0;
  font-weight: 700;
}

/* ===== Mobile upcoming ===== */
.rdc-bento-mobile-upcoming-{{ section.id }} {
  display: none;
}

/* ===== Carrousel mobile ===== */
.rdc-bento-carousel-{{ section.id }} {
  display: none;
  position: relative;
  overflow: hidden;
}

.rdc-carousel-track-{{ section.id }} {
  display: flex;
  transition: transform 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.rdc-carousel-slide-{{ section.id }} {
  min-width: 100%;
  flex: 0 0 100%;
  display: flex;
  justify-content: center;
  box-sizing: border-box;
}

.rdc-carousel-slide-{{ section.id }} .rdc-bento-card-{{ section.id }} {
  width: calc(100% - {{ section.settings.mobile_slide_gap }}px);
  border-radius: {{ section.settings.card_border_radius }}px;
}

.rdc-carousel-dots-{{ section.id }} {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  margin-top: 16px;
  min-height: 14px;
  position: relative;
  z-index: 20;
}

.rdc-carousel-dot-{{ section.id }} {
  display: block;
  flex: 0 0 10px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(var(--color-foreground), 0.35);
  border: 1px solid rgba(var(--color-background), 0.8);
  padding: 0;
  cursor: pointer;
  appearance: none;
  opacity: 1;
  transition: transform 0.3s ease, background-color 0.3s ease;
}

.rdc-carousel-dot-{{ section.id }}.active {
  background: rgba(var(--color-foreground), 0.9);
  transform: scale(1.25);
}

/* ===== Mobile ===== */
@media screen and (max-width: 749px) {
  .rdc-bento-desktop-{{ section.id }} {
    display: none !important;
  }

  .rdc-bento-mobile-upcoming-{{ section.id }} {
    display: block;
    margin-bottom: {{ section.settings.cards_gap }}px;
  }

  .rdc-bento-mobile-upcoming-list-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.cards_gap }}px;
  }

  .rdc-bento-carousel-{{ section.id }} {
    display: block;
    overflow: visible;
  }

  .rdc-bento-card-{{ section.id }}:not(.rdc-bento-brand-card-{{ section.id }}):hover .rdc-bento-img {
    transform: none;
    filter: none;
  }

  .rdc-bento-card-{{ section.id }}:not(.rdc-bento-brand-card-{{ section.id }}):hover .rdc-bento-card-img-wrap-{{ section.id }}::after {
    opacity: 0;
  }

  .rdc-bento-brand-bg-image-{{ section.id }} {
    transform: scale(1.06);
  }

  .rdc-bento-brand-motif-left-{{ section.id }} {
    left: var(--rdc-brand-left-motif-offset-mobile, 0%);
  }

  .rdc-bento-brand-motif-right-{{ section.id }} {
    right: var(--rdc-brand-right-motif-offset-mobile, 0%);
  }

  .rdc-bento-brand-title-image-{{ section.id }},
  .rdc-bento-card-title-image-{{ section.id }} {
    max-width: min(100%, var(--rdc-title-image-mobile-max-width, 220px));
    max-height: var(--rdc-title-image-mobile-max-height, 100px);
  }

  .rdc-bento-title-overlay-{{ section.id }} .rdc-bento-title,
  .rdc-bento-title-below-{{ section.id }} .rdc-bento-title {
    font-size: {{ section.settings.mobile_title_font_size }}px;
  }

  .rdc-bento-upcoming-card-{{ section.id }} .rdc-bento-card-img-wrap-{{ section.id }} {
    min-height: 420px;
  }

  .rdc-bento-upcoming-title-image-{{ section.id }} img {
    max-width: min(100%, var(--rdc-upcoming-title-image-max-width-mobile, 420px));
    max-height: var(--rdc-upcoming-title-image-max-height-mobile, 210px);
  }

  .rdc-bento-upcoming-form-row-{{ section.id }} {
    flex-direction: column;
  }

  .rdc-bento-carousel-{{ section.id }} .rdc-bento-card-img-wrap-{{ section.id }} {
    aspect-ratio: 16 / 10;
    min-height: 0;
    max-height: none;
  }

  .rdc-bento-carousel-{{ section.id }} .rdc-bento-img,
  .rdc-bento-carousel-{{ section.id }} .rdc-bento-card-img-wrap-{{ section.id }} > svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rdc-bento-carousel-{{ section.id }} .rdc-bento-brand-bg-image-{{ section.id }} {
    transform: scale(1.06);
  }
}
{%- endstyle -%}

{%- assign all_cards = '' -%}
{%- assign has_upcoming = false -%}
{%- assign upcoming_form_class = 'rdc-bento-upcoming-form-' | append: section.id -%}

{%- for block in section.blocks -%}
  {%- if block.type == 'card' or block.type == 'upcoming_collection' -%}
    {%- if all_cards != '' -%}{%- assign all_cards = all_cards | append: ',' -%}{%- endif -%}
    {%- assign all_cards = all_cards | append: block.id -%}
  {%- endif -%}

  {%- if block.type == 'upcoming_collection' -%}
    {%- assign has_upcoming = true -%}
  {%- endif -%}
{%- endfor -%}

{%- assign card_ids = all_cards | split: ',' -%}
{%- assign card_index = 0 -%}

<section class="rdc-bento-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="rdc-bento-container-{{ section.id }}">

    <div class="rdc-bento-desktop-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          {%- assign row_layout = block.settings.row_layout -%}
          {%- assign row_class = 'rdc-row-' | append: row_layout -%}

          {%- if row_layout == '3equal' -%}
            {%- assign cards_in_row = 3 -%}
          {%- elsif row_layout == '1full' -%}
            {%- assign cards_in_row = 1 -%}
          {%- else -%}
            {%- assign cards_in_row = 2 -%}
          {%- endif -%}

          <div class="rdc-bento-row-{{ section.id }} {{ row_class }}" {{ block.shopify_attributes }}>
            {%- for i in (1..cards_in_row) -%}
              {%- if card_index < card_ids.size -%}
                {%- assign current_card_id = card_ids[card_index] -%}

                {%- for b in section.blocks -%}
                  {%- if b.id == current_card_id -%}
                    {%- assign card_flex_style = '' -%}

                    {%- if row_layout == '2split' -%}
                      {%- assign split = block.settings.split_ratio -%}
                      {%- if split == '30-70' -%}
                        {%- if i == 1 -%}{%- assign card_pct = 30 -%}{%- else -%}{%- assign card_pct = 70 -%}{%- endif -%}
                      {%- elsif split == '40-60' -%}
                        {%- if i == 1 -%}{%- assign card_pct = 40 -%}{%- else -%}{%- assign card_pct = 60 -%}{%- endif -%}
                      {%- elsif split == '50-50' -%}
                        {%- assign card_pct = 50 -%}
                      {%- elsif split == '60-40' -%}
                        {%- if i == 1 -%}{%- assign card_pct = 60 -%}{%- else -%}{%- assign card_pct = 40 -%}{%- endif -%}
                      {%- elsif split == '70-30' -%}
                        {%- if i == 1 -%}{%- assign card_pct = 70 -%}{%- else -%}{%- assign card_pct = 30 -%}{%- endif -%}
                      {%- else -%}
                        {%- assign card_pct = 50 -%}
                      {%- endif -%}

                      {%- capture card_flex_style -%}flex: 0 0 calc({{ card_pct }}% - {{ section.settings.cards_gap | divided_by: 2 }}px);{%- endcapture -%}
                    {%- endif -%}

                    {%- if b.type == 'card' -%}
                      {%- assign card_tag = 'div' -%}
                      {%- assign card_href = '' -%}

                      {%- if b.settings.link != blank -%}
                        {%- assign card_tag = 'a' -%}
                        {%- assign card_href = b.settings.link -%}
                      {%- elsif b.settings.collection != blank -%}
                        {%- assign card_tag = 'a' -%}
                        {%- assign card_href = b.settings.collection.url -%}
                      {%- endif -%}

                      {%- assign display_title = b.settings.title -%}
                      {%- if display_title == blank and b.settings.collection != blank -%}
                        {%- assign display_title = b.settings.collection.title -%}
                      {%- endif -%}

                      {%- assign is_brand_card = b.settings.brand_visual_enabled -%}

                      {%- assign title_align = 'left' -%}
                      {%- if b.settings.title_image != blank -%}
                        {%- assign title_align = b.settings.title_image_alignment | default: 'center' -%}
                      {%- endif -%}

                      {%- if title_align == 'center' -%}
                        {%- assign title_align_css = 'center' -%}
                        {%- assign title_text_align = 'center' -%}
                      {%- elsif title_align == 'right' -%}
                        {%- assign title_align_css = 'flex-end' -%}
                        {%- assign title_text_align = 'right' -%}
                      {%- else -%}
                        {%- assign title_align_css = 'flex-start' -%}
                        {%- assign title_text_align = 'left' -%}
                      {%- endif -%}

                      {%- assign show_title_area = false -%}
                      {%- if section.settings.title_position != 'hidden' -%}
