    },
    {
      "type": "url",
      "id": "link_url",
      "label": "URL du lien",
      "info": "Utilisé seulement si 'Lien simple' est sélectionné"
    },
    {
      "type": "header",
      "content": "Paramètres du pop-up"
    },
    {
      "type": "select",
      "id": "behavior",
      "label": "Comportement du pop-up",
      "options": [
        {
          "value": "default",
          "label": "Par défaut"
        },
        {
          "value": "drawer",
          "label": "Tiroir"
        }
      ],
