              --rdc-brand-gradient-opacity: {{ block.settings.brand_side_gradient_opacity | divided_by: 100.0 }};
              --rdc-brand-gradient-width: {{ block.settings.brand_side_gradient_width }}%;
              --rdc-brand-motif-opacity: {{ block.settings.brand_motif_opacity | divided_by: 100.0 }};
              --rdc-brand-motif-blur: {{ block.settings.brand_motif_blur }}px;
