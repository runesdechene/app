    .rdc-hero {
      padding: 0;
      z-index: 2147483647; /* max int 32-bit, passe au-dessus de tout (chat Shopify inclus) */
    }

    .rdc-hero__modal {
      max-width: 100vw;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      max-height: none;
      border-radius: 0;
      box-shadow: none;
      display: block;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
      background-color: #0a0804;
    }

    /* Image fixée au viewport : reste en fond même quand le contenu scroll */
    .rdc-hero__media {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .rdc-hero__media img {
      object-position: center center;
    }

    /* Parchemin masqué sur mobile */
    .rdc-hero__frame {
      display: none;
    }

    /* Overlay fixe, uniforme sur toute la hauteur du viewport */
    .rdc-hero__overlay {
      position: fixed;
      inset: 0;
      z-index: 1;
      background: rgba(54, 42, 42, 0.5);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    /* Contenu aligné haut, texte commence dès le haut de l'écran */
    .rdc-hero__content {
      position: relative;
      inset: auto;
      z-index: 5;
      padding: 0.5rem 1.25rem 2.5rem;
      min-height: 100vh;
      min-height: 100dvh;
      justify-content: flex-start;
      pointer-events: auto;
      margin-top: 0;
      max-width: 100vw;
      box-sizing: border-box;
    }

    /* Close : translucide blanc, fixed viewport */
    .rdc-hero__close {
      position: fixed;
      width: 32px;
      height: 32px;
      top: 1rem;
      right: 1rem;
      z-index: 20;
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
    }

    .rdc-hero__close:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    /* Tous les textes en blanc, sans ombre (overlay uniforme suffit) */
    .rdc-hero__overline,
    .rdc-hero__title,
    .rdc-hero__subtitle,
    .rdc-hero__subtitle *,
    .rdc-hero__pitch,
    .rdc-hero__tagline {
      color: #fff !important;
    }

    .rdc-hero__title {
      font-size: 2.6rem;
    }

    .rdc-hero__overline {
      font-size: 1.5rem;
      letter-spacing: 0.15em;
      margin: 0 0 -0.25rem;
      opacity: 0.92;
    }

    .rdc-hero__top {
      max-width: 100%;
      gap: 10px;
    }

    .rdc-hero__subtitle {
      font-size: 1rem;
      text-align: left;
    }

    /* Perks : pastilles translucides blanches */
    .rdc-hero__perk {
      background-color: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.4);
      color: #fff;
    }

    /* CTA primaire : inversé, fond blanc sur cinématique sombre */
    .rdc-hero__cta--primary {
      background-color: #fff !important;
      color: #1a1410 !important;
      border-color: #fff !important;
      padding: 0.875rem 1rem !important;
      font-size: 0.95rem;
      min-height: 48px;
    }

    .rdc-hero__cta--primary:hover {
      background-color: rgba(255, 255, 255, 0.9) !important;
      border-color: rgba(255, 255, 255, 0.9) !important;
    }

    /* CTA secondaire : transparent, bordure + texte blanc */
    .rdc-hero__cta--secondary {
      background-color: transparent !important;
      color: #fff !important;
      border-color: rgba(255, 255, 255, 0.75) !important;
      padding: 0.875rem 1rem !important;
      font-size: 0.95rem;
      min-height: 48px;
    }

    .rdc-hero__cta--secondary:hover {
      background-color: rgba(255, 255, 255, 0.1) !important;
      border-color: #fff !important;
    }
  }

  /* Macaron flottant — bas-gauche, fixed, permet de rouvrir la modal */
  .rdc-hero__reopen {
    position: fixed;
    bottom: 2.25rem;
    left: 2.25rem;
    z-index: 9998;
    width: 104px;
    height: 104px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: var(--rdc-hero-cta-primary-color, var(--rdc-hero-text-color, #2a2418));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.15), 0 2px 6px rgba(0, 0, 0, 0.05);
    animation: rdcHeroReopenPulse 2.4s ease-in-out infinite;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    pointer-events: auto;
  }

  .rdc-hero__reopen:hover {
    transform: scale(1.08);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.25), 0 4px 8px rgba(0, 0, 0, 0.1);
    animation-play-state: paused;
  }

  .rdc-hero__reopen-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  @keyframes rdcHeroReopenPulse {
    0%, 100% { box-shadow: 0 6px 24px rgba(199, 114, 114, 0.25), 0 0 0 0 rgba(var(--rdc-hero-cta-primary-rgb, 42, 36, 24), 0.4); }
    50%      { box-shadow: 0 6px 24px rgba(197, 39, 39, 0.25), 0 0 0 14px rgba(var(--rdc-hero-cta-primary-rgb, 42, 36, 24), 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rdc-hero__reopen { animation: none; }
  }

  /* Cacher le macaron quand la modal est ouverte */
  body:has(.rdc-hero.is-open) .rdc-hero__reopen {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.5);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  /* Mobile : macaron un peu plus petit, plus serré au bord */
  @media screen and (max-width: 749px) {
    .rdc-hero__reopen {
      width: 56px;
      height: 56px;
      bottom: 1rem;
      left: 1rem;
    }
  }

  /* Masquer le chat Shopify Inbox (et variantes) quand la popup est ouverte */
  body:has(.rdc-hero.is-open) #shopify-chat,
  body:has(.rdc-hero.is-open) [id^="shopify-chat"],
  body:has(.rdc-hero.is-open) [id^="shopify-inbox"],
  body:has(.rdc-hero.is-open) shopify-chat,
  body:has(.rdc-hero.is-open) iframe[name*="shopify_inbox"],
  body:has(.rdc-hero.is-open) iframe[src*="shopify_inbox"] {
    display: none !important;
  }

  /* Theme editor : forcer l'affichage en design mode pour pouvoir éditer la modal */
  .shopify-section[data-shopify-editor-active] .rdc-hero,
  .rdc-hero[data-shopify-design-mode="true"] {
    display: flex;
    pointer-events: auto;
  }
