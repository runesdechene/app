      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Gauche",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
