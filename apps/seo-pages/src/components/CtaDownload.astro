---
interface Props {
  placeName: string;
}

const { placeName } = Astro.props;
---

<section style="padding: 3rem 0; text-align: center;">
  <div class="container">
    <h2 style="color: var(--color-text); margin-bottom: 0.5rem;">
      Explorez {placeName} sur l'app
    </h2>
    <p style="color: var(--color-muted); margin-bottom: 1.5rem;">
      Runes de Chêne — gratuite, sans pub, faite par des passionnés.
    </p>
    <a href="https://carte.runesdechene.com" class="btn-primary">
      Télécharger l'application
    </a>
  </div>
</section>
