{% comment %}
Collection vignette – version auto height propre
{% endcomment %}

<div 
  class="collection-vignette"
  style="
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  "
>

  {% if section.settings.link != blank %}
    <a href="{{ section.settings.link }}" class="collection-vignette__link"></a>
  {% endif %}

  <picture class="collection-vignette__picture">
    
    {% if section.settings.image_mobile != blank %}
      <source 
        media="(max-width: 749px)" 
        srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}"
      >
    {% endif %}

    {% if section.settings.image_desktop != blank %}
      <img
        src="{{ section.settings.image_desktop | image_url: width: 2000 }}"
        alt="{{ section.settings.image_desktop.alt | escape }}"
        class="collection-vignette__image"
        loading="lazy"
      >
    {% endif %}

  </picture>

</div>

<style>
.collection-vignette {
  width: 100%;
  position: relative;
}

/* conteneur image */
.collection-vignette__picture {
  display: block;
  width: 100%;
}

/* 🔥 IMAGE = maître du layout */
.collection-vignette__image {
  width: 100%;
  height: auto; /* 🔥 clé */
  display: block;
}

/* lien full */
.collection-vignette__link {
  position: absolute;
  inset: 0;
  z-index: 2;
}
</style>

{% schema %}
{
  "name": "Collection vignette",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image Mobile"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection vignette"
    }
  ]
}
{% endschema %}