<script>
  (function () {
    var modal = document.getElementById('RdcHeroSaison-{{ section.id }}');
    if (!modal) {
      console.warn('[rdc-hero] modal element not found');
      return;
    }

    var delay = parseFloat(modal.getAttribute('data-popup-delay')) || 0;
    var storageKey = modal.getAttribute('data-popup-storage-key') || 'rdc_hero_seen';
    var showOnce = modal.getAttribute('data-popup-show-once') === 'true';

    var savedScrollY = 0;

    function lockBodyScroll() {
      savedScrollY = window.scrollY || window.pageYOffset || 0;
      document.body.style.position = 'fixed';
      document.body.style.top = '-' + savedScrollY + 'px';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    }

    function unlockBodyScroll() {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      window.scrollTo(0, savedScrollY);
    }

    function open() {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.addEventListener('keydown', onKey);
      lockBodyScroll();
    }

    function close(markSeen) {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.removeEventListener('keydown', onKey);
      unlockBodyScroll();
      if (markSeen && showOnce) {
        try { localStorage.setItem(storageKey, '1'); } catch (e) {}
      }
    }

    function onKey(e) {
      if (e.key === 'Escape') close(false);
    }

    modal.querySelectorAll('[data-rdc-hero-close]').forEach(function (el) {
      el.addEventListener('click', function () {
        var markSeen = el.classList.contains('rdc-hero__close');
        close(markSeen);
      });
    });

    // Macaron de réouverture (placé hors du .rdc-hero, donc on le cherche dans le DOM global)
    var reopenBtn = document.querySelector('[data-rdc-hero-reopen][data-rdc-hero-target="' + modal.id + '"]');
    if (reopenBtn) {
      reopenBtn.addEventListener('click', function () {
        try { localStorage.removeItem(storageKey); } catch (e) {}
        open();
      });
    }

    // Tagline slideshow : auto-rotation 4s + dots cliquables
    var slideshow = modal.querySelector('[data-rdc-tagline-slideshow]');
    if (slideshow) {
      var slides = slideshow.querySelectorAll('.rdc-hero__tagline--slide');
      var dots = slideshow.querySelectorAll('.rdc-hero__taglines-dot');
      var current = 0;
      var slideInterval = null;
      var ROTATION_MS = 4000;

      function showSlide(index) {
        slides.forEach(function (s, i) { s.classList.toggle('is-active', i === index); });
        dots.forEach(function (d, i) {
          d.classList.toggle('is-active', i === index);
          d.setAttribute('aria-selected', i === index ? 'true' : 'false');
        });
        current = index;
      }

      function nextSlide() { showSlide((current + 1) % slides.length); }

      if (slides.length > 1) {
        slideInterval = setInterval(nextSlide, ROTATION_MS);

        dots.forEach(function (dot, i) {
          dot.addEventListener('click', function () {
            clearInterval(slideInterval);
            showSlide(i);
            slideInterval = setInterval(nextSlide, ROTATION_MS);
          });
        });
      }
    }

    var inEditor = window.Shopify && window.Shopify.designMode;
    if (inEditor) {
      open();
      return;
    }

    if (showOnce) {
      try {
        if (localStorage.getItem(storageKey)) return;
      } catch (e) {}
    }

    if (delay > 0) {
      setTimeout(open, delay * 1000);
    } else {
      open();
    }
  })();
</script>

