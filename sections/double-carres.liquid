        { "type": "color", "id": "btn_hover_border_color", "label": "Bordure bouton (hover)", "default": "#962B21" },

        { "type": "header", "content": "🌫️ Overlay" },
        { "type": "color", "id": "overlay_color", "label": "Couleur overlay", "default": "#000000" },
        {
          "type": "range", "id": "overlay_opacity",
          "label": "Opacité overlay (repos)",
          "min": 0, "max": 100, "step": 5, "unit": "%", "default": 35
        },
        {
          "type": "range", "id": "overlay_opacity_hover",
          "label": "Opacité overlay (hover)",
          "min": 0, "max": 100, "step": 5, "unit": "%", "default": 20,
          "info": "Réduit au hover pour laisser l'image ressortir"
        },

        { "type": "header", "content": "✨ Animation" },
        {
          "type": "checkbox", "id": "disable_animation",
          "label": "Désactiver l'animation", "default": false
        },
        {
          "type": "range", "id": "zoom_factor",
          "label": "Intensité du zoom photo",
          "min": 100, "max": 140, "step": 1, "unit": "%", "default": 110,
          "info": "100% = pas de zoom · 110% = léger · 130% = prononcé"
        },
        {
          "type": "range", "id": "saturation_rest",
          "label": "Saturation au repos",
          "min": 0, "max": 100, "step": 5, "unit": "%", "default": 75,
          "info": "100% = couleurs normales · 75% = légèrement désaturé · 0% = noir & blanc"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RDC – Double Carrés",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
