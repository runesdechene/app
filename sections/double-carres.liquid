{%- style -%}
  .rdc-section-{{ section.id }} {
    display: block;
    width: 100%;
    margin-top: {{ section.settings.section_margin_top }}px;
    margin-bottom: {{ section.settings.section_margin_bottom }}px;
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    background-color: rgba(var(--color-background), 1);
    color: rgba(var(--color-foreground), 1);
  }

  .rdc-container-{{ section.id }} {
    display: flex;
    gap: {{ section.settings.cards_gap }}px;
    margin: 0 auto;
  }

  /* Largeur : page (max-width du thème) ou pleine largeur */
  {%- if section.settings.section_width == 'page' -%}
    .rdc-container-{{ section.id }} {
      max-width: var(--page-width, {{ section.settings.section_max_width }}px);
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  {%- else -%}
    .rdc-container-{{ section.id }} {
      max-width: none;
      padding-left: {{ section.settings.section_padding_horizontal }}px;
      padding-right: {{ section.settings.section_padding_horizontal }}px;
    }
  {%- endif -%}

  /* --- CARTES --- */
  {%- for block in section.blocks -%}
    #rdc-card-{{ block.id }} {
      position: relative;
      flex: 1;
      min-height: {{ section.settings.card_height }}px;
      border-radius: {{ section.settings.card_border_radius }}px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: {{ section.settings.content_vertical_alignment }};
      align-items: {{ section.settings.content_horizontal_alignment }};
      padding: {{ section.settings.card_padding }}px;
      text-decoration: none;
    }

    /* --- IMAGE DE FOND --- */
    #rdc-card-{{ block.id }} .rdc-card-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
      filter: saturate({{ block.settings.saturation_rest | divided_by: 100.0 }});
      transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1), filter 0.6s ease;
    }

    /* --- OVERLAY INDIVIDUEL --- */
    #rdc-card-{{ block.id }} .rdc-overlay {
      position: absolute;
      inset: 0;
      z-index: 2;
      background-color: {{ block.settings.overlay_color }};
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
      transition: opacity 0.4s ease;
    }

    /* --- ANIMATION HOVER : zoom image + saturation --- */
    {%- unless block.settings.disable_animation -%}
      #rdc-card-{{ block.id }}:hover .rdc-card-img {
        transform: scale({{ block.settings.zoom_factor | divided_by: 100.0 }});
        filter: saturate(1);
      }
      #rdc-card-{{ block.id }}:hover .rdc-overlay {
        opacity: {{ block.settings.overlay_opacity_hover | divided_by: 100.0 }};
      }
    {%- endunless -%}

    /* --- BOUTON INDIVIDUEL --- */
    #rdc-card-{{ block.id }} .rdc-btn {
      display: inline-block;
      padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
      background-color: {{ block.settings.btn_bg }};
      color: {{ block.settings.btn_text_color }};
      text-decoration: none;
      border-radius: {{ section.settings.button_border_radius }}px;
      font-size: {{ section.settings.button_font_size }}px;
      font-weight: {{ section.settings.button_font_weight }};
      border: {{ section.settings.button_border_width }}px solid {{ block.settings.btn_border_color }};
      transition: all 0.3s ease;
      position: relative;
      z-index: 4;
      cursor: pointer;
    }
    #rdc-card-{{ block.id }} .rdc-btn:hover {
      background-color: {{ block.settings.btn_hover_bg }};
      color: {{ block.settings.btn_hover_text_color }};
      border-color: {{ block.settings.btn_hover_border_color }};
    }
  {%- endfor -%}

  /* --- CONTENU --- */
  .rdc-content-{{ section.id }} {
    position: relative;
    z-index: 3;
    text-align: {{ section.settings.text_alignment }};
    max-width: 100%;
  }

  .rdc-title-{{ section.id }} {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    margin: 0 0 {{ section.settings.title_margin_bottom }}px;
    line-height: 1.15;
  }

  .rdc-subtitle-{{ section.id }} {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_font_size }}px;
    font-weight: {{ section.settings.subtitle_font_weight }};
    margin: 0 0 {{ section.settings.subtitle_margin_bottom }}px;
    opacity: 0.9;
    line-height: 1.4;
  }

  /* --- MOBILE --- */
  @media screen and (max-width: 749px) {
    .rdc-container-{{ section.id }} {
      flex-direction: column;
      gap: {{ section.settings.mobile_cards_gap }}px;
    }

    {%- for block in section.blocks -%}
      #rdc-card-{{ block.id }} {
        width: {{ section.settings.mobile_card_width }}%;
        min-height: {{ section.settings.mobile_card_height }}px;
        margin: 0 auto;
      }
    {%- endfor -%}

    .rdc-title-{{ section.id }} {
      font-size: {{ section.settings.mobile_title_font_size }}px;
    }

    .rdc-subtitle-{{ section.id }} {
      font-size: {{ section.settings.mobile_subtitle_font_size }}px;
    }

    #rdc-card-{{ block.id }} .rdc-btn,
    .rdc-btn-mobile-size {
      font-size: {{ section.settings.mobile_button_font_size }}px;
    }
  }
{%- endstyle -%}

<section class="rdc-section-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="rdc-container-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- comment -%} Choix : lien global (toute la carte) ou lien bouton uniquement {%- endcomment -%}
      {%- assign card_tag = 'div' -%}
      {%- assign card_link_attr = '' -%}
      {%- if block.settings.link_mode == 'card' and block.settings.card_link != blank -%}
        {%- assign card_tag = 'a' -%}
        {%- assign card_link_attr = 'href="' | append: block.settings.card_link | append: '"' -%}
      {%- endif -%}

      <{{ card_tag }} {{ card_link_attr }} id="rdc-card-{{ block.id }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
            class="rdc-card-img"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'rdc-card-img' }}
        {%- endif -%}

        <div class="rdc-overlay"></div>

        <div class="rdc-content-{{ section.id }}">
          {%- if block.settings.title != blank -%}
            <h2 class="rdc-title-{{ section.id }}">{{ block.settings.title }}</h2>
          {%- endif -%}
          {%- if block.settings.subtitle != blank -%}
            <p class="rdc-subtitle-{{ section.id }}">{{ block.settings.subtitle }}</p>
          {%- endif -%}
          {%- if block.settings.btn_label != blank -%}
            {%- if block.settings.link_mode == 'button' and block.settings.btn_link != blank -%}
              <a href="{{ block.settings.btn_link }}" class="rdc-btn">{{ block.settings.btn_label }}</a>
            {%- else -%}
              <span class="rdc-btn">{{ block.settings.btn_label }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>
      </{{ card_tag }}>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RDC – Double Carrés",
  "max_blocks": 3,
  "class": "rdc-dual-section",
  "settings": [
    {
      "type": "header",
      "content": "🎨 Combinaison de couleurs"
    },
    {
      "type": "color_scheme",
