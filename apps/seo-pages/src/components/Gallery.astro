---
interface Props {
  images: Array<{ id: string; url: string; thumb?: string }>;
  title: string;
  placeName: string;
}

const { images, title, placeName } = Astro.props;
const displayImages = images.slice(0, 5);
const mainImage = displayImages[0] ?? null;
---
<aside class="gallery" data-gallery>
  <div class="gallery-main">
    {mainImage ? (
      <img src={mainImage.url} alt={title} loading="eager" data-gallery-main />
    ) : (
      <div class="gallery-placeholder">
        <span>Aucune photo</span>
      </div>
    )}
    {displayImages.length > 1 && (
      <div class="gallery-dots">
        {displayImages.map((_, i) => (
          <button
            class={`gallery-dot${i === 0 ? ' active' : ''}`}
            aria-label={`Photo ${i + 1}`}
            data-gallery-dot={i}
          />
        ))}
      </div>
    )}
  </div>
  {displayImages.length > 1 && (
    <div class="gallery-thumbs">
      {displayImages.map((img, i) => (
        <div class={`gallery-thumb${i === 0 ? ' active' : ''}`} data-gallery-thumb={i}>
          <img src={img.thumb || img.url} alt={`${title} — photo ${i + 1}`} loading="lazy" />
        </div>
      ))}
    </div>
  )}
  <a href="https://carte.runesdechene.com" class="gallery-cta">
    <img
      src="/app-icon.png"
      alt="Runes de Chêne"
      class="gallery-cta-logo"
      loading="lazy"
    />
    <span>
      Découvrir ce lieu sur La Carte
      <span class="gallery-cta-sub">Éco-tourisme d'aventure &middot; 2500+ lieux à explorer &middot; Gratuit</span>
    </span>
  </a>
  <script define:vars={{ urls: displayImages.map(img => img.url) }}>
    const gallery = document.querySelector('[data-gallery]');
    if (gallery && urls.length > 1) {
      const mainImg = gallery.querySelector('[data-gallery-main]');
      const dots = gallery.querySelectorAll('[data-gallery-dot]');
      const thumbs = gallery.querySelectorAll('[data-gallery-thumb]');

      function goTo(index) {
        mainImg.src = urls[index];
        dots.forEach((d, i) => d.classList.toggle('active', i === index));
        thumbs.forEach((t, i) => t.classList.toggle('active', i === index));
      }

      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
      thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => goTo(i)));
    }
  </script>
</aside>
