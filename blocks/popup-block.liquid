

{% assign block_settings = block.settings %}

{%- if block_settings.link_type == 'url' -%}
  {%- comment -%} Lien simple vers une URL {%- endcomment -%}
  <a
    href="{{ block_settings.link_url }}"
    class="popup-block__trigger popup-block__trigger--link spacing-style"
    {{ block.shopify_attributes }}
    style="
      --block-padding-top: {{ block_settings['padding-block-start'] }}px;
      --block-padding-bottom: {{ block_settings['padding-block-end'] }}px;
      --block-padding-left: {{ block_settings['padding-inline-start'] }}px;
      --block-padding-right: {{ block_settings['padding-inline-end'] }}px;
      --text-color: {{ block_settings.text_color }};
    "
  >
    <div class="popup-block__content" style="gap: {{ block_settings.content_gap }}px;">
      {%- if block_settings.title != blank -%}
        <h3 class="popup-block__title {{ block_settings.title_preset }}">
          {{ block_settings.title }}
          {{- 'icon-external.svg' | inline_asset_content -}}
        </h3>
      {%- endif -%}
      
      {%- if block_settings.description != blank -%}
        <div class="popup-block__description">
          {{ block_settings.description }}
        </div>
      {%- endif -%}
      
      {%- if block_settings.button_text != blank -%}
        <span class="popup-block__button button button--primary">
          {{ block_settings.button_text }}
        </span>
      {%- endif -%}
    </div>
  </a>

{%- else -%}
  {%- comment -%} Bouton popup {%- endcomment -%}
  <script
    src="{{ 'dialog.js' | asset_url }}"
    type="module"
  ></script>

  <dialog-component
    class="popup-block"
    {{ block.shopify_attributes }}
  >
    <button
      on:click="/showDialog"
      class="popup-block__trigger spacing-style"
      style="
        --block-padding-top: {{ block_settings['padding-block-start'] }}px;
        --block-padding-bottom: {{ block_settings['padding-block-end'] }}px;
        --block-padding-left: {{ block_settings['padding-inline-start'] }}px;
        --block-padding-right: {{ block_settings['padding-inline-end'] }}px;
        --text-color: {{ block_settings.text_color }};
      "
    >
      <div class="popup-block__content" style="gap: {{ block_settings.content_gap }}px;">
        {%- if block_settings.title != blank -%}
          <h3 class="popup-block__title {{ block_settings.title_preset }}">
            {{ block_settings.title }}
            {{- 'icon-external.svg' | inline_asset_content -}}
          </h3>
        {%- endif -%}
        
        {%- if block_settings.description != blank -%}
          <div class="popup-block__description">
            {{ block_settings.description }}
          </div>
        {%- endif -%}
        
        {%- if block_settings.button_text != blank -%}
          <span class="popup-block__button button button--primary">
            {{ block_settings.button_text }}
          </span>
        {%- endif -%}
      </div>
    </button>

    <dialog
      ref="dialog"
      class="popup-block__modal dialog-modal color-{{ settings.popover_color_scheme }}{% if block_settings.behavior == 'drawer' %} popup-block__modal--drawer dialog-drawer{% endif %}"
      scroll-lock
      aria-labelledby="popup-block-heading"
    >
      <h2
        id="popup-block-heading"
        class="visually-hidden"
      >
        {{ block_settings.title }}
      </h2>
      <div class="popup-block__inner">
        {% content_for 'blocks' %}
      </div>
      <button
        ref="closeButton"
        on:click="/closeDialog"
        class="button button-unstyled close-button popup-block__close"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </dialog>
  </dialog-component>
{%- endif -%}

{% stylesheet %}
  .popup-block {
    display: flex;
    width: 100%;
    align-self: stretch;
    margin: 0 !important;
  }

  .popup-block .popup-block__trigger {
    flex: 1;
  }

  .popup-block__trigger {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background-color: var(--color-background-secondary);
    border: var(--style-border);
    border-radius: var(--style-border-radius);
    cursor: pointer;
    padding-block-start: var(--block-padding-top, 40px);
    padding-block-end: var(--block-padding-bottom, 40px);
    padding-inline-start: var(--block-padding-left, 40px);
    padding-inline-end: var(--block-padding-right, 40px);
    transition: box-shadow var(--animation-speed) var(--animation-easing);
    position: relative;
    overflow: hidden;
    text-align: left;
    margin: 0;
  }

  .popup-block__trigger--link {
    text-decoration: none;
    color: inherit;
  }

  .popup-block__trigger:hover {
    box-shadow: var(--shadow-card);
  }

  .popup-block__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--margin-m);
    color: var(--text-color, #ffffff);
  }

  .popup-block__title {
    margin: 0;
  }

  .popup-block__title svg {
    display: inline-block;
    position: relative;
    top: 0;
    margin-left: 0.25em;
    transform: scale(1.5);
    transform-origin: left center;
  }

  .popup-block__description {
    margin: 0;
    font-size: 1rem;
    font-family: var(--font-body--family);
  }

  .popup-block__button {
    align-self: flex-start;
    margin-top: var(--margin-s);
  }

  .popup-block__modal {
    box-shadow: var(--shadow-popover);
    border: var(--style-border-popover);
    border-radius: var(--style-border-radius-popover);
    background-color: var(--color-background);
    padding: var(--padding-4xl) var(--padding-xl) var(--padding-xl);
    max-width: var(--normal-content-width);
    max-height: var(--modal-max-height);

    @media screen and (min-width: 750px) {
      padding: var(--padding-5xl);
    }
  }

  .popup-block__modal[open] {
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .popup-block__modal.dialog-closing {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .popup-block__modal--drawer {
    position: fixed;
    border-radius: 0;
    width: var(--sidebar-width);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
  }

  /* Needed to ensure the drawer is full height */
  .popup-block__modal--drawer:modal {
    max-height: 100dvh;
  }

  .popup-block__close {
    top: var(--margin-2xs);
    right: var(--margin-2xs);
    opacity: 0.8;
    animation: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bloc Pop-Up",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "header",
